# ==========================================
# Droppy Leak Detection Suite .gitignore
# ==========================================

# --- IDEs & Editors ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.iml

# --- System Files ---
Thumbs.db
desktop.ini
.DS_Store

# --- Python / FastAPI ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
pip-log.txt
pip-delete-this-directory.txt

# --- Java / Spring Boot ---
core-service/target/
target/
*.class
*.jar
*.war
*.ear
*.nar

# --- Maven Binaries & Distributions ---
.mvn-bin/
.mvn/wrapper/maven-wrapper.jar

# --- Angular / Node ---
dashboard-angular/node_modules/
dashboard-angular/dist/
dashboard-angular/.angular/
dashboard-angular/.vscode/
node_modules/
dist/
.angular/

# --- Local Environment & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.log

# --- Large Datasets & Models (Uncomment to exclude) ---
# *.csv
# models/*.joblib
# models/*.pkl
