<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="antigravity">
        <createTable tableName="droppy_anomaly">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="mac" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="score" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="start_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="end_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="droppy_anomaly"
                columnNames="mac, type, start_at"
                constraintName="uc_droppy_anomaly_mac_type_start"/>
    </changeSet>

</databaseChangeLog>
